    overflow-x: hidden;
    position: relative;
  }

  /* ---------- AMBIENT BACKGROUND ---------- */
  .bg-glow {
    position: fixed; inset: -10%; z-index: 0; pointer-events: none;
    background:
      radial-gradient(600px circle at 15% 20%, rgba(201,162,39,0.14), transparent 60%),
      radial-gradient(520px circle at 88% 12%, rgba(123,63,242,0.11), transparent 60%),
      radial-gradient(560px circle at 78% 82%, rgba(110,36,48,0.16), transparent 60%),
      radial-gradient(460px circle at 18% 88%, rgba(47,169,140,0.11), transparent 60%);
    filter: blur(20px);
    animation: drift 26s ease-in-out infinite alternate;
  }
  @keyframes drift {
    0% { background-position: 0 0, 0 0, 0 0, 0 0; }
    100% { background-position: 50px 70px, -40px 50px, -60px -40px, 40px -50px; }
  }
  .grain {
    position: fixed; inset: 0; z-index: 6; pointer-events: none; opacity: .05; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .hero, section, #contacto, .cta-band, footer, #stats-strip { position: relative; z-index: 1; }
  nav { z-index: 40; }
  @media (prefers-reduced-motion: reduce) { .bg-glow { animation: none; } }

  /* ---------- SECTION TINTING ---------- */
  #perfil { background: linear-gradient(180deg, transparent 0%, rgba(201,162,39,0.035) 100%); }
  #plataformas { background: rgba(123,63,242,0.03); }
  #faq { background: linear-gradient(180deg, rgba(110,36,48,0.04) 0%, transparent 100%); }
  h1, h2, h3, .serif { font-family: 'Fraunces', serif; font-weight: 500; }
  a { color: inherit; }
  img, svg { max-width: 100%; }
  button { font-family: inherit; }

  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }

  /* ---------- reveal-on-scroll ---------- */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.in-view { opacity: 1; transform: translateY(0); }
  .reveal-stagger > * { opacity: 0; transform: translateY(16px); transition: opacity .55s ease, transform .55s ease; }
  .reveal-stagger.in-view > * { opacity: 1; transform: translateY(0); }
  .reveal-stagger.in-view > *:nth-child(1) { transition-delay: .02s; }
  .reveal-stagger.in-view > *:nth-child(2) { transition-delay: .08s; }
  .reveal-stagger.in-view > *:nth-child(3) { transition-delay: .14s; }
  .reveal-stagger.in-view > *:nth-child(4) { transition-delay: .20s; }
  .reveal-stagger.in-view > *:nth-child(5) { transition-delay: .26s; }
  .reveal-stagger.in-view > *:nth-child(6) { transition-delay: .32s; }
  .reveal-stagger.in-view > *:nth-child(7) { transition-delay: .38s; }
  @media (prefers-reduced-motion: reduce) {
    .reveal, .reveal-stagger > * { opacity: 1; transform: none; transition: none; }
