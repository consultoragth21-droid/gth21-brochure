  }
  .svc-row:hover::before, .svc-row.open::before { left: 0; }
  .svc-head { position: relative; z-index: 1; display: flex; align-items: center; gap: 22px; padding: 24px 4px; }
  .svc-num { font-family: 'Fraunces', serif; font-size: 15px; color: var(--gold); width: 34px; flex: none; }
  .svc-title { font-size: clamp(18px, 2.6vw, 24px); color: var(--cream); flex: 1; font-family: 'Fraunces', serif; font-weight: 500; }
  .svc-arrow { flex: none; width: 20px; height: 20px; transition: transform .3s ease; }
  .svc-arrow svg { width: 100%; height: 100%; stroke: var(--gold-soft); fill: none; stroke-width: 1.6; }
  .svc-row.open .svc-arrow { transform: rotate(135deg); }
  .svc-body { position: relative; z-index: 1; max-height: 0; overflow: hidden; transition: max-height .4s ease; }
