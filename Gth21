  /* ---------- SERVICES ACCORDION ---------- */
  .svc-row {
    border-bottom: 1px solid var(--hair);
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
  .svc-row::before {
    content: ''; position: absolute; inset: 0; left: -100%;
