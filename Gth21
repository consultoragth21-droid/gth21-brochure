  .pcar-arrow:hover { border-color: var(--gold); }
  .pcar-arrow svg { width: 16px; height: 16px; stroke: var(--gold-soft); fill: none; stroke-width: 1.8; }

  /* ---------- CASE ---------- */
  .case-panel {
    border: 1px solid var(--hair); padding: 40px 36px; background: var(--bg-raised);
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 36px;
  }
  .case-panel .tag { font-size: 13px; color: var(--gold-soft); margin: 0 0 10px; }
  .case-panel h3 { font-size: 24px; margin: 0 0 8px; line-height: 1.3; color: var(--cream); }
  .case-panel .meta { font-size: 14px; color: var(--muted); margin: 0; }
  .case-text { font-family: 'Fraunces', serif; font-size: 19px; line-height: 1.6; color: var(--cream); border-left: 2px solid var(--gold); padding-left: 22px; margin: 0; }
  @media (max-width: 760px) { .case-panel { grid-template-columns: 1fr; } }

  /* ---------- FAQ ---------- */
  .faq-row { border-bottom: 1px solid var(--hair); cursor: pointer; }
  .faq-head { display: flex; align-items: center; gap: 18px; padding: 22px 4px; }
  .faq-num { font-family: 'Fraunces', serif; font-size: 14px; color: var(--gold); width: 26px; flex: none; }
  .faq-q { font-size: 16.5px; color: var(--cream); flex: 1; font-weight: 500; }
  .faq-arrow { flex: none; width: 18px; height: 18px; transition: transform .3s ease; }
  .faq-arrow svg { width: 100%; height: 100%; stroke: var(--gold-soft); fill: none; stroke-width: 1.6; }
  .faq-row.open .faq-arrow { transform: rotate(45deg); }
  .faq-body { max-height: 0; overflow: hidden; transition: max-height .4s ease; }
  .faq-row.open .faq-body { max-height: 220px; }
  .faq-body p { margin: 0 4px 22px 44px; font-size: 14.5px; line-height: 1.65; color: var(--muted); max-width: 58ch; }

  /* ---------- CONTACT FORM ---------- */
  .contact-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .field { margin-bottom: 18px; }
  .field label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 7px; }
  .field input, .field select, .field textarea {
    width: 100%; background: var(--bg-raised); border: 1px solid var(--hair);
    color: var(--cream); padding: 12px 14px; font-size: 15px; font-family: 'Inter', sans-serif;
    border-radius: 2px; outline: none; transition: border-color .2s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--gold); }
  .field textarea { resize: vertical; min-height: 90px; }
  .form-note { font-size: 12.5px; color: var(--muted); margin-top: 4px; }
  .contact-info-list { list-style: none; margin: 0; padding: 0; }
  .contact-info-list li { padding: 16px 0; border-bottom: 1px solid var(--hair); font-size: 15px; }
  .contact-info-list li small { display: block; color: var(--muted); font-size: 12.5px; margin-bottom: 4px; }
  .contact-info-list li a { color: var(--gold-soft); text-decoration: none; border-bottom: 1px solid var(--hair); }
  .contact-info-list li a:hover { border-bottom-color: var(--gold-soft); }
  @media (max-width: 760px) { .contact-grid2 { grid-template-columns: 1fr; gap: 8px; } }

  /* ---------- CTA BAND ---------- */
  .cta-band { text-align: center; padding: 80px 0; }
  .cta-band h2 { font-size: clamp(28px, 4.4vw, 42px); margin: 0 0 28px; color: var(--cream); }

  /* ---------- FOOTER ---------- */
  footer { padding: 34px 0 calc(28px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--hair); }
  .footer-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted); }
  .footer-links { display: flex; gap: 18px; }
  .footer-links a:hover { color: var(--gold-soft); }

  /* ---------- WA FLOAT ---------- */
  .wa-float {
    position: fixed; right: 22px; bottom: calc(22px + env(safe-area-inset-bottom, 0px));
    width: 56px; height: 56px; border-radius: 50%; background: var(--gold);
    border: 1px solid var(--gold-soft); display: flex; align-items: center; justify-content: center;
    text-decoration: none; z-index: 50; box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    transition: transform .15s ease;
  }
  .wa-float:hover { transform: scale(1.06); }
  .wa-float svg { width: 26px; height: 26px; fill: #1A1712; }
</style>
