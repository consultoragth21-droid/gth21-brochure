  /* ---------- PLATFORMS MARQUEE ---------- */
  .marquee-shell { overflow: hidden; border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); padding: 26px 0; }
  .marquee-track { display: flex; gap: 64px; width: max-content; animation: scroll-left 22s linear infinite; }
