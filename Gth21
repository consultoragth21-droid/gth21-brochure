  .advantage-bar .icon { flex: none; width: 22px; height: 22px; margin-top: 2px; }
  .advantage-bar .icon svg { width: 100%; height: 100%; stroke: var(--gold-soft); fill: none; stroke-width: 1.5; }
  .advantage-bar h4 { font-size: 15.5px; margin: 0 0 4px; color: var(--cream); font-weight: 500; font-family: 'Inter', sans-serif; }
  .advantage-bar p { font-size: 14.5px; color: var(--muted); line-height: 1.6; margin: 0; }

  /* ---------- GLOW LINE ---------- */
  .glow-line {
    width: 60px; height: 2px; margin: 0 0 18px;
    background: linear-gradient(90deg, var(--gold), var(--gold-soft));
    animation: pulse-glow 2.6s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%, 100% { opacity: .35; box-shadow: 0 0 0px rgba(201,162,39,0); }
    50% { opacity: 1; box-shadow: 0 0 14px rgba(230,195,92,.6); }
  }
  @media (prefers-reduced-motion: reduce) { .glow-line { animation: none; opacity: .8; } }

  /* ---------- STATS STRIP ---------- */
  .stats-strip {
    display: grid; grid-template-columns: repeat(4, 1fr);
