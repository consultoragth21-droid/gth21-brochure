  @keyframes scroll-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item { display: flex; align-items: center; gap: 12px; font-family: 'Fraunces', serif; font-size: 22px; color: var(--cream); white-space: nowrap; }
  .marquee-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }

  .advantage-bar {
    margin-top: 36px; padding: 20px 24px; border-left: 2px solid var(--gold);
