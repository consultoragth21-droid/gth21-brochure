  /* ---------- SECTION SHELL ---------- */
  section { padding: 72px 0; border-top: 1px solid var(--hair); }
  .kicker { font-size: 13px; color: var(--gold-soft); margin: 0 0 12px; letter-spacing: .04em; }
  .section-head { max-width: 60ch; margin: 0 0 44px; }
