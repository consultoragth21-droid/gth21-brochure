  }
  .stat-item { text-align: center; padding: 40px 16px; border-right: 1px solid var(--hair); }
  .stat-item:last-child { border-right: none; }
  .stat-num { font-family: 'Fraunces', serif; font-size: clamp(32px, 5vw, 46px); color: var(--gold-soft); line-height: 1; }
  .stat-label { font-size: 13px; color: var(--muted); margin-top: 8px; }
  @media (max-width: 640px) {
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .stat-item { border-bottom: 1px solid var(--hair); }
  }

  /* ---------- PLATFORM CAROUSEL ---------- */
  .pcar-shell { position: relative; margin-top: 32px; }
  .pcar-track {
    display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; padding-bottom: 6px;
  }
  .pcar-track::-webkit-scrollbar { display: none; }
  .pcar-card {
    flex: 0 0 min(340px, 82vw); scroll-snap-align: start;
    background: var(--bg-raised); border: 1px solid var(--hair);
    border-top: 3px solid var(--card-accent, var(--gold));
    padding: 28px 26px; display: flex; flex-direction: column; gap: 14px;
  }
  .pcar-card .chip-row { display: flex; align-items: center; gap: 10px; }
  .pcar-card .chip-row .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--card-accent, var(--gold)); }
  .pcar-card h3 { font-size: 22px; margin: 0; color: var(--cream); }
  .pcar-card p { font-size: 14.5px; line-height: 1.6; color: var(--muted); margin: 0; }
  .pcar-card ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .pcar-card ul li { font-size: 13.5px; color: var(--cream); padding-left: 16px; position: relative; }
  .pcar-card ul li::before { content: ''; position: absolute; left: 0; top: 7px; width: 6px; height: 6px; border-radius: 50%; background: var(--card-accent, var(--gold)); }
  .pcar-demo-link {
    margin-top: auto; padding-top: 10px; font-size: 13.5px; font-weight: 500;
    color: var(--card-accent, var(--gold-soft)); text-decoration: none;
    border-top: 1px solid var(--hair); display: flex; align-items: center; gap: 6px;
  }
  .pcar-demo-link svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.8; }
  .pcar-nav { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; }
  .pcar-dots { display: flex; gap: 8px; }
  .pcar-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--hair); cursor: pointer; transition: background .2s ease, transform .2s ease; border: none; padding: 0; }
